{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/labels/label_local_protection_schema.json",
  "title": "Label Local Key Protection",
  "description": "Metadata stored with a member private key that the browser protects locally (flow a). Wrapping key = HKDF-SHA256(ikm, info `traigent.label.local.v1`) where ikm is the WebAuthn PRF output (passkey) or Argon2id(passphrase) (fallback); cipher AES-256-GCM, random 96-bit nonce, AAD = canonical {tenant_ref, member_key_id, purpose:\"local_member_key\", version}. This record holds only what is needed to re-derive the wrapping key: credential id and PRF input salt, or Argon2id salt and parameters, plus nonce and ciphertext. A PRF output, a passphrase, or a wrapping key is NEVER a field here, and a closed schema keeps it that way. Normally stays in the browser; if uploaded it must be built by an explicit sanitized serializer, never native credential toJSON.",
  "definitions": {
    "Argon2idParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "salt",
        "memory_kib",
        "iterations",
        "parallelism"
      ],
      "properties": {
        "salt": {
          "x-content-class": "key_material",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 22,
          "maxLength": 22,
          "description": "16-byte random salt, unpadded base64url.",
          "x-content-note": "public salt, not customer content"
        },
        "memory_kib": {
          "x-content-class": "number",
          "type": "integer",
          "const": 65536
        },
        "iterations": {
          "x-content-class": "number",
          "type": "integer",
          "const": 3
        },
        "parallelism": {
          "x-content-class": "number",
          "type": "integer",
          "const": 1
        }
      }
    },
    "LocalProtection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "member_key_id",
        "protection",
        "nonce",
        "ciphertext"
      ],
      "properties": {
        "version": {
          "$ref": "label_common_schema.json#/definitions/SchemaVersion"
        },
        "member_key_id": {
          "$ref": "label_common_schema.json#/definitions/KeyId"
        },
        "protection": {
          "x-content-class": "closed_enum",
          "type": "string",
          "enum": [
            "passkey_prf",
            "passphrase_argon2id"
          ]
        },
        "credential_id": {
          "x-content-class": "key_material",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 16,
          "maxLength": 1024,
          "description": "WebAuthn credential id, unpadded base64url. Required for passkey_prf.",
          "x-content-note": "random WebAuthn credential id generated by the authenticator, not customer content"
        },
        "prf_input_salt": {
          "x-content-class": "key_material",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 16,
          "maxLength": 86,
          "description": "The PRF eval.first input (public, per credential; by default SHA-256 of `traigent.label.member.v1`||member_key_id). NOT the PRF output. Required for passkey_prf.",
          "x-content-note": "public PRF input, not the PRF output"
        },
        "argon2id": {
          "$ref": "#/definitions/Argon2idParams"
        },
        "nonce": {
          "$ref": "label_common_schema.json#/definitions/Nonce12"
        },
        "ciphertext": {
          "x-content-class": "encrypted_blob",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 64,
          "maxLength": 64,
          "description": "48 bytes (32-byte X25519 private key + 16-byte tag), unpadded base64url."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "protection": {
                "const": "passkey_prf"
              }
            },
            "required": [
              "protection"
            ]
          },
          "then": {
            "required": [
              "credential_id",
              "prf_input_salt"
            ],
            "not": {
              "required": [
                "argon2id"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "protection": {
                "const": "passphrase_argon2id"
              }
            },
            "required": [
              "protection"
            ]
          },
          "then": {
            "required": [
              "argon2id"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "credential_id"
                  ]
                },
                {
                  "required": [
                    "prf_input_salt"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "$ref": "#/definitions/LocalProtection"
}
