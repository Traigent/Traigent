{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/optimization/hybrid_session_create_request_schema.json",
  "title": "Hybrid Session Create Request",
  "description": "POST /api/v1/hybrid/sessions request. Accepts the canonical backend shape and the SDK legacy shape; prompt-like text is capped at 10,000 characters.",
  "type": "object",
  "x-content-class": "legacy_content",
  "x-content-key-class": "legacy_content",
  "x-content-note": "INV-GAP (reclassified by review): open payload root accepts extra properties that carry no class; names and values are unclassified",
  "additionalProperties": true,
  "definitions": {
    "ModelSpec": {
      "x-content-key-class": "legacy_content",
      "x-content-class": "legacy_content",
      "x-content-note": "INV-GAP H1: not inventoried (free object/array): ModelSpec",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "model_name": {
          "x-content-class": "legacy_content",
          "x-content-note": "INV-GAP H1: not inventoried (free string): model_name",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "provider": {
          "x-content-class": "legacy_content",
          "x-content-note": "INV-GAP H1: not inventoried (free string): provider",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "temperature": {
          "x-content-class": "number",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 2
        },
        "max_tokens": {
          "x-content-class": "number",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "model_name"
      ]
    },
    "CanonicalTypedObjectiveDefinition": {
      "allOf": [
        {
          "$ref": "https://schemas.traigent.ai/optimization/objective_definition_schema.json"
        },
        {
          "type": "object",
          "required": [
            "name",
            "orientation",
            "weight"
          ]
        }
      ]
    },
    "LegacyObjectObjectiveDefinition": {
      "x-content-key-class": "legacy_content",
      "x-content-class": "legacy_content",
      "x-content-note": "INV-GAP H1: not inventoried (free object/array): LegacyObjectObjectiveDefinition",
      "type": "object",
      "description": "Legacy SDK/backend objective object accepted by TraigentBackend interactive_session_service._normalize_objectives.",
      "required": [
        "metric"
      ],
      "anyOf": [
        {
          "required": [
            "direction"
          ]
        },
        {
          "required": [
            "band"
          ]
        }
      ],
      "additionalProperties": true,
      "properties": {
        "metric": {
          "x-content-class": "legacy_content",
          "x-content-note": "INV-GAP H1: not inventoried (free string): metric",
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "direction": {
          "x-content-class": "closed_enum",
          "type": "string",
          "enum": [
            "maximize",
            "minimize"
          ]
        },
        "weight": {
          "x-content-class": "number",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "band": {
          "$ref": "#/definitions/LegacyObjectiveBand"
        },
        "test": {
          "x-content-class": "closed_enum",
          "type": "string",
          "enum": [
            "TOST"
          ]
        },
        "alpha": {
          "x-content-class": "number",
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "LegacyObjectiveBand": {
      "x-content-key-class": "legacy_content",
      "x-content-class": "legacy_content",
      "x-content-note": "INV-GAP H1: not inventoried (free object/array): LegacyObjectiveBand",
      "type": "object",
      "oneOf": [
        {
          "required": [
            "low",
            "high"
          ]
        },
        {
          "required": [
            "center",
            "tol"
          ]
        }
      ],
      "additionalProperties": true,
      "properties": {
        "low": {
          "x-content-class": "number",
          "type": "number"
        },
        "high": {
          "x-content-class": "number",
          "type": "number"
        },
        "center": {
          "x-content-class": "number",
          "type": "number"
        },
        "tol": {
          "x-content-class": "number",
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "TypedObjectiveArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/CanonicalTypedObjectiveDefinition"
          },
          {
            "$ref": "#/definitions/LegacyObjectObjectiveDefinition"
          }
        ]
      }
    },
    "LegacyStringObjectiveArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "x-content-class": "legacy_content",
        "x-content-note": "INV-GAP H1: not inventoried (free string): items",
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "properties": {
    "config_space": {
      "type": "array",
      "minItems": 2,
      "maxItems": 200,
      "items": {
        "x-content-key-class": "legacy_content",
        "x-content-class": "legacy_content",
        "x-content-note": "INV H1-2 (LEAK): config_space",
        "type": "object",
        "additionalProperties": true
      }
    },
    "task_description": {
      "x-content-class": "legacy_content",
      "x-content-note": "INV H1-1 (LEAK): task_description",
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "problem_statement": {
      "x-content-class": "legacy_content",
      "x-content-note": "INV H1-1 (LEAK): problem_statement",
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "search_space": {
      "x-content-class": "legacy_content",
      "x-content-note": "INV H1-2 (LEAK): search_space",
      "oneOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 200,
          "items": {
            "x-content-key-class": "legacy_content",
            "x-content-class": "legacy_content",
            "x-content-note": "INV H1-2 (LEAK): search_space",
            "type": "object",
            "additionalProperties": true
          }
        },
        {
          "x-content-class": "legacy_content",
          "x-content-key-class": "legacy_content",
          "x-content-note": "INV-GAP (implicit-open, reclassified by review): object accepts properties it does not declare (additionalProperties omitted or true); extra names and values are unclassified",
          "type": "object",
          "additionalProperties": true
        }
      ]
    },
    "optimization_config": {
      "x-content-key-class": "legacy_content",
      "x-content-class": "legacy_content",
      "x-content-note": "INV H1-3 (OPEN): optimization_config",
      "type": "object",
      "additionalProperties": true
    },
    "algorithm": {
      "$ref": "https://schemas.traigent.ai/optimization/optimization_strategy_schema.json#/definitions/SupportedOptimizationStrategyName",
      "default": "auto",
      "description": "Public SDK optimization algorithm selector. auto lets Traigent choose cloud-first automatic execution with local fallback."
    },
    "offline": {
      "x-content-class": "closed_enum",
      "type": "boolean",
      "default": false,
      "description": "force fully-local execution with no backend egress."
    },
    "trial_sequencing": {
      "x-content-class": "closed_enum",
      "type": "string",
      "enum": [
        "client",
        "backend"
      ],
      "default": "backend",
      "description": "Who decides which configuration each trial runs. 'backend' (default, fully backward-compatible): the server allocates trial ids from its own optimizer budget and may end the session early once it decides no further trials are useful. 'client': the caller (e.g. a locally-sequenced exhaustive grid or random search) decides trial order and count; the server allocates trial ids on demand and must not early-stop the session from its own optimizer trial-count budget, which becomes informational only. This transfers trial sequencing only: it does not disable or relax any spend, time, rate, or security limit that applies to the session."
    },
    "hybrid_api_options": {
      "$ref": "https://schemas.traigent.ai/optimization/hybrid_api_options_schema.json",
      "description": "Optional external evaluator configuration. Meaningful only when an external evaluator is configured."
    },
    "optimization_strategy": {
      "x-content-class": "legacy_content",
      "x-content-note": "INV H1-3 (OPEN): arbitrary legacy objects remain accepted",
      "description": "Optional strategy configuration. The typed vNext shape is optimization_strategy_schema; arbitrary legacy objects remain accepted for compatibility.",
      "anyOf": [
        {
          "$ref": "https://schemas.traigent.ai/optimization/optimization_strategy_schema.json"
        },
        {
          "x-content-class": "legacy_content",
          "x-content-key-class": "legacy_content",
          "x-content-note": "INV-GAP (implicit-open, reclassified by review): object accepts properties it does not declare (additionalProperties omitted or true); extra names and values are unclassified",
          "type": "object",
          "additionalProperties": true
        }
      ]
    },
    "epsilon": {
      "x-content-class": "number",
      "type": "number",
      "minimum": 0.01,
      "maximum": 2
    },
    "delta": {
      "x-content-class": "number",
      "type": "number",
      "minimum": 0.001,
      "maximum": 0.5
    },
    "max_rounds": {
      "x-content-class": "number",
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "items_per_round": {
      "x-content-class": "number",
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "eval_dataset": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "x-content-key-class": "legacy_content",
        "x-content-class": "legacy_content",
        "x-content-note": "INV H1-5 (LEAK): eval_dataset",
        "type": "object",
        "additionalProperties": true
      }
    },
    "generator_model": {
      "oneOf": [
        {
          "$ref": "#/definitions/ModelSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "judge_model": {
      "oneOf": [
        {
          "$ref": "#/definitions/ModelSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluation_criteria": {
      "x-content-class": "legacy_content",
      "x-content-note": "INV H1-7 (LEAK): evaluation_criteria",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10000
    },
    "scored_examples": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "x-content-key-class": "legacy_content",
        "x-content-class": "legacy_content",
        "x-content-note": "INV H1-6 (LEAK): scored_examples",
        "type": "object",
        "additionalProperties": true,
        "required": [
          "content"
        ]
      }
    },
    "metadata": {
      "x-content-key-class": "legacy_content",
      "x-content-class": "legacy_content",
      "x-content-note": "INV H1-4 (OPEN): metadata",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "strategy_preset": {
          "$ref": "https://schemas.traigent.ai/optimization/strategy_preset_schema.json",
          "description": "Optional advisory strategy preset metadata recorded for this session."
        }
      },
      "additionalProperties": true
    },
    "promotion_policy": {
      "$ref": "https://schemas.traigent.ai/optimization/promotion_policy_schema.json"
    },
    "objectives": {
      "description": "Optional optimization objectives for hybrid session creation. Accepts canonical typed objective definitions, legacy SDK/backend objective objects, and the legacy SDK string-array form.",
      "oneOf": [
        {
          "$ref": "#/definitions/TypedObjectiveArray"
        },
        {
          "$ref": "#/definitions/LegacyStringObjectiveArray"
        }
      ]
    }
  },
  "anyOf": [
    {
      "required": [
        "config_space",
        "task_description"
      ]
    },
    {
      "required": [
        "search_space",
        "problem_statement"
      ]
    }
  ],
  "allOf": [
    {
      "description": "Legacy execution selectors removed (Traigent#2271): execution_mode and the flat hybrid_api_* keys are no longer accepted request selectors. Use algorithm/offline for execution behavior and the nested hybrid_api_options object for external evaluator configuration.",
      "not": {
        "anyOf": [
          { "required": ["execution_mode"] },
          { "required": ["hybrid_api_endpoint"] },
          { "required": ["hybrid_api_transport"] },
          { "required": ["hybrid_api_transport_type"] },
          { "required": ["hybrid_api_batch_size"] },
          { "required": ["hybrid_api_batch_parallelism"] },
          { "required": ["hybrid_api_keep_alive"] },
          { "required": ["hybrid_api_heartbeat_interval"] },
          { "required": ["hybrid_api_timeout"] },
          { "required": ["hybrid_api_auth_header"] },
          { "required": ["hybrid_api_auto_discover_tvars"] },
          { "required": ["hybrid_api_tunable_id"] }
        ]
      }
    }
  ]
}
