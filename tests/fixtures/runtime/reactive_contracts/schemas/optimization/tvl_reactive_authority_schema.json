          "$ref": "./tvl_reactive_common_schema.json#/definitions/ReservationRef"
        },
        "attempt_ref": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/AttemptRef"
        },
        "grant_ref": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/GrantRef"
