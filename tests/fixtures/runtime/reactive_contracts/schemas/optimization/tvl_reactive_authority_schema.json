        "state": {
          "x-content-class": "closed_enum",
          "type": "string",
          "enum": [
            "granted",
            "declined",
            "expired",
            "revoked"
          ]
        },
        "contract_digest": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Digest"
        },
        "ceiling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_trials",
            "max_cost_micro_usd"
