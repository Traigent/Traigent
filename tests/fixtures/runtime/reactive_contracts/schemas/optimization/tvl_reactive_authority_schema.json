            },
            "expected_head_generation": {
              "$ref": "./tvl_reactive_common_schema.json#/definitions/Generation",
              "description": "Agent-head generation READ AT APPROVAL time; a head move after approval refuses the deploy."
            }
          },
          "description": "Deploy bindings of a grant."
        },
        "head_moved_since_optimization_start": {
          "x-content-class": "closed_enum",
          "type": "boolean",
          "description": "Deploy grants only: the head generation at approval differs from the one captured at optimization start (shown to the approver)."
        },
        "decided_by": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/UserRef"
        },
        "decided_at": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Timestamp"
        },
        "expires_at": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Timestamp"
        }
      },
      "description": "A recorded human approval grant (create response and read model). The `approval` fact in the evaluation history is generated from this row."
    },
    "ReservationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "reservation_key",
        "grant_ref"
      ],
      "properties": {
        "schema_version": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/SchemaVersion"
        },
        "reservation_key": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/IdempotencyKey"
        },
