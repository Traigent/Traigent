        },
        "replayed": {
          "x-content-class": "closed_enum",
          "type": "boolean"
        }
      },
      "description": "A pending reservation. A reservation that expires before start means nothing started and simply frees."
    },
    "StartRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "start_key",
        "reservation_ref",
        "reservation_generation"
      ],
      "properties": {
        "schema_version": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/SchemaVersion"
