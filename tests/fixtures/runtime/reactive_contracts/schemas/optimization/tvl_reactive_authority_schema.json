{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/optimization/tvl_reactive_authority_schema.json",
  "title": "TvlReactiveAuthority",
  "description": "Human approval grants, reservations, start authorization, effect outcome facts, cancel and the attempt read model of the TVL 1.4 reactive layer (TRAIG-101 plan 4.2, 5.3, 7). Authority is created only by the principal named for each record; ingestion facts merely report.",
  "definitions": {
    "HeartbeatRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "heartbeat_key",
        "reservation_ref",
        "reservation_generation"
      ],
      "properties": {
        "schema_version": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/SchemaVersion"
        },
        "heartbeat_key": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/IdempotencyKey"
        },
        "reservation_ref": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/ReservationRef"
        },
        "reservation_generation": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Generation"
        }
      },
      "description": "Lease renewal. The lease of an effect is its reservation: before start it is the reservation expiry, after start it is renewed by heartbeats bound to the EXISTING reservation and its generation (no new reservation, no second start). A holder that stops renewing becomes `lapsed`; a stale generation is 409 reservation_generation_stale. The SDK also cancels a run whose lease it lost."
    },
    "HeartbeatReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "attempt_ref",
        "lease_expires_at",
        "replayed"
      ],
      "properties": {
        "schema_version": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/SchemaVersion"
        },
        "attempt_ref": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/AttemptRef"
        },
        "lease_expires_at": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Timestamp"
        },
        "replayed": {
          "x-content-class": "closed_enum",
          "type": "boolean"
        }
      },
      "description": "Receipt of a lease renewal."
    },
    "ApprovalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "attempt_ref",
        "policy_revision_ref",
        "effect",
        "state",
        "contract_digest"
      ],
      "properties": {
        "schema_version": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/SchemaVersion"
        },
        "attempt_ref": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/AttemptRef"
        },
        "policy_revision_ref": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/PolicyRevisionRef"
        },
        "effect": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Effect",
          "description": "The effect a grant would authorize next."
        },
        "state": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/AttemptState"
        },
        "contract_digest": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Digest",
          "description": "Digest of the CURRENT contract; the grant must bind it."
        },
        "candidate_fingerprint": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Digest",
          "description": "Deploy only: fingerprint of the promotable candidate."
        },
        "gate_result_digest": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Digest",
          "description": "Deploy only: digest of the promotion gate result under the current contract digest."
        },
        "optimization_start_generation": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Generation",
          "description": "Deploy only: agent-head generation captured when optimization started."
        },
        "current_head_generation": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Generation",
          "description": "Deploy only: agent-head generation now; the grant binds THIS value as expected_head_generation."
        },
        "head_moved_since_optimization_start": {
          "x-content-class": "closed_enum",
          "type": "boolean",
          "description": "Deploy only: the two generations differ (the approver is shown both)."
        }
      },
      "description": "Everything a portal approver needs to build a grant for one attempt. P-human only; read-only; closed fields.",
      "oneOf": [
        {
          "properties": {
            "effect": {
              "x-content-class": "closed_enum",
              "type": "string",
              "const": "optimize"
            }
          },
          "required": [
            "effect"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "candidate_fingerprint"
                ]
              },
              {
                "required": [
                  "gate_result_digest"
                ]
              },
              {
                "required": [
                  "optimization_start_generation"
                ]
              },
              {
                "required": [
                  "current_head_generation"
                ]
              },
              {
                "required": [
                  "head_moved_since_optimization_start"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "effect": {
              "x-content-class": "closed_enum",
              "type": "string",
              "const": "deploy"
            }
          },
          "required": [
            "effect",
            "candidate_fingerprint",
            "gate_result_digest",
            "optimization_start_generation",
            "current_head_generation",
            "head_moved_since_optimization_start"
          ]
        }
      ]
    },
    "GrantCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "grant_key",
        "attempt_ref",
        "effect",
        "decision",
        "contract_digest"
      ],
      "properties": {
        "schema_version": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/SchemaVersion"
        },
        "grant_key": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/IdempotencyKey"
        },
        "attempt_ref": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/AttemptRef"
        },
        "effect": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Effect"
        },
        "decision": {
          "x-content-class": "closed_enum",
          "type": "string",
          "enum": [
            "granted",
            "declined"
          ]
        },
        "contract_digest": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Digest",
          "description": "Digest of the CURRENT contract the human approved against."
        },
        "duration_hours": {
          "x-content-class": "closed_enum",
          "type": "integer",
          "enum": [
            1,
            4,
            24
          ],
          "description": "Grant lifetime in hours; the server clock sets the expiry."
        },
        "ceiling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_trials",
            "max_cost_micro_usd"
          ],
          "properties": {
            "max_trials": {
              "x-content-class": "number",
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "max_cost_micro_usd": {
              "x-content-class": "number",
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            }
          },
          "description": "Optimize ceiling bound into the grant (trials and cost in millionths of a US dollar)."
        },
        "deploy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_fingerprint",
            "gate_result_digest",
            "expected_head_generation"
          ],
          "properties": {
            "candidate_fingerprint": {
              "$ref": "./tvl_reactive_common_schema.json#/definitions/Digest"
            },
            "gate_result_digest": {
              "$ref": "./tvl_reactive_common_schema.json#/definitions/Digest"
            },
            "expected_head_generation": {
              "$ref": "./tvl_reactive_common_schema.json#/definitions/Generation",
              "description": "Agent-head generation READ AT APPROVAL time; a head move after approval refuses the deploy."
            }
          },
          "description": "Deploy bindings of a grant."
        }
      },
      "description": "Create a human approval decision for one effect of one attempt. P-human only (a session of a user with agent write access); an SDK API key is 403 forbidden. Binds policy revision, rule, scope, occurrence, effect, contract digest, ceiling or deploy bindings and expiry. Standing grants do not exist.",
      "oneOf": [
        {
          "properties": {
            "decision": {
              "x-content-class": "closed_enum",
              "type": "string",
              "const": "granted"
            },
            "effect": {
              "x-content-class": "closed_enum",
              "type": "string",
              "const": "optimize"
            }
          },
          "required": [
            "decision",
            "effect",
            "duration_hours",
            "ceiling"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "deploy"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "decision": {
              "x-content-class": "closed_enum",
              "type": "string",
              "const": "granted"
            },
            "effect": {
              "x-content-class": "closed_enum",
              "type": "string",
              "const": "deploy"
            }
          },
          "required": [
            "decision",
            "effect",
            "duration_hours",
            "deploy"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "ceiling"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "decision": {
              "x-content-class": "closed_enum",
              "type": "string",
              "const": "declined"
            }
          },
          "required": [
            "decision"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "duration_hours"
                ]
              },
              {
                "required": [
                  "ceiling"
                ]
              },
              {
                "required": [
                  "deploy"
                ]
              }
            ]
          }
        }
      ]
    },
