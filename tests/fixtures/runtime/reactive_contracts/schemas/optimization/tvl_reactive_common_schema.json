{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/optimization/tvl_reactive_common_schema.json",
  "title": "TvlReactiveCommon",
  "description": "Shared closed vocabularies of the TVL 1.4 reactive layer (TRAIG-101, S1): hosted tokens, server-issued refs, digests, bounded integers, the closed refusal envelope. Reviewed closed-contract expansion (GNFR-PRIV-002(f)): every field of the reactive wire contracts is a hosted token or server ref, an enum, a bounded integer, a boolean, a digest or a server timestamp. No free text and no customer-chosen name crosses this channel. See docs/tvl-reactive-contracts.md.",
  "definitions": {
    "SchemaVersion": {
      "x-content-class": "closed_enum",
      "type": "integer",
      "const": 1,
      "description": "TVL reactive contract version."
    },
    "HostedToken": {
      "x-content-class": "key_material",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 17,
      "maxLength": 17,
      "allOf": [
        {
          "pattern": "^t[A-Za-z0-9_-]{16}$"
        }
      ],
      "description": "Hosted token minted by the customer-side SDK for a compiled TVL name (response, rule, monitor, scope, environment, requirement): the letter t followed by 16 base64url characters of a random value (never a hash or a name; tvl-token-map/1 entries from the SDK). The Backend validates OWNERSHIP: the token must exist in the stored response-policy revision's refs, or be a scope previously announced by an `opened` or `fired` fact of the same agent, with one exception: the first authenticated `stale` or `live_again` liveness fact may establish its own customer-minted scope (a fresh random token), bound to the agent, environment, policy revision and liveness monitor, without a preceding `opened` or `fired` fact, and is authorized through the primary monitor the liveness monitor observes (native primaries stay refused); episode `continued` and `closed` facts still need a scope announced by `opened`; an unknown token is refused without echo. A token that does not have this exact shape is refused at the schema."
    },
    "Digest": {
      "x-content-class": "digest",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 64,
      "description": "Lowercase hex SHA-256 digest (contract digest, candidate fingerprint, gate-result digest, revision value)."
    },
    "IdempotencyKey": {
      "x-content-class": "key_material",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 32,
      "maxLength": 32,
      "allOf": [
        {
          "pattern": "^[0-9a-f]{32}$"
        }
      ],
      "description": "128-bit random idempotency key, client-generated, 32 lowercase hex characters (a nonce, never derived from a name). Same key and same request returns the stored receipt; the same key with any difference is 409 idempotency_conflict."
    },
    "Hours": {
      "x-content-class": "number",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000,
      "description": "Integer lifecycle hours (an instant or a window bound), 0 to 1000000000."
    },
    "Occurrence": {
      "x-content-class": "number",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000,
      "description": "Zero-based occurrence index of an optimize rule firing within its attempt identity."
    },
    "Generation": {
      "x-content-class": "number",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Agent-head or reservation generation, 0 to 2^53-1."
    },
    "Timestamp": {
      "x-content-class": "timestamp",
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "description": "Server-set point in time (RFC 3339 UTC)."
    },
    "UserRef": {
      "x-content-class": "opaque_ref",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36,
      "description": "UUID of the authenticated principal that made a human decision (no name or email)."
    },
    "PolicyRevisionRef": {
      "x-content-class": "opaque_ref",
      "type": "string",
      "pattern": "^policyrevisionref_[0-9a-f]{32}$",
      "maxLength": 50,
      "description": "Server-issued reference to a response-policy revision (the Backend-computed digest identity of the canonical response semantics, not the contract digest)."
    },
    "AttemptRef": {
      "x-content-class": "opaque_ref",
      "type": "string",
      "pattern": "^attemptref_[0-9a-f]{32}$",
      "maxLength": 43,
      "description": "Server-issued reference to an optimize/deploy attempt, created at Freeze when a rule fires."
    },
    "GrantRef": {
      "x-content-class": "opaque_ref",
      "type": "string",
