{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/legend/v0/recovery_manifest_v0.json",
  "title": "Recovery Manifest V0",
  "description": "Recovery manifest whose scheme-qualified fingerprint is the ClientStore key. Closed schema (additionalProperties false everywhere, closed enums, no free text): any new field or enum value ships as a new schema_version published alongside this one; consumers dispatch on schema_version. Normative text: docs/identity/pillar-legend-v0.md. Every string pattern ends with the portable end anchor (?![\\s\\S]) rather than $.",
  "version": "0.1.0",
  "definitions": {
    "RepresentationKind": {
      "type": "string",
      "enum": [
        "source_bundle",
        "prompt_files",
        "helper_modules",
        "tool_definitions",
        "config_document",
        "dependency_lock",
        "dataset_rows",
        "evaluator_bundle",
        "judge_config_document",
        "search_space_document"
      ]
    },
    "Representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "representation_kind",
        "digest",
        "byte_length"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "representation_kind": {
          "$ref": "#/definitions/RepresentationKind"
        },
        "digest": {
          "$ref": "./pillar_legend_v0.json#/definitions/Sha256Digest"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "Dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_ref",
        "kind"
      ],
      "properties": {
        "version_ref": {
          "$ref": "./pillar_legend_v0.json#/definitions/VersionRef"
        },
        "kind": {
          "$ref": "./pillar_legend_v0.json#/definitions/EntityKind"
        }
      },
      "description": "Another declared version this capture needs to be restorable (by opaque ref, never by name)."
    },
    "Ordering": {
      "type": "string",
      "enum": [
        "preserved",
        "not_applicable"
      ]
    },
    "RecoveryManifestV0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "manifest_scheme",
        "kind",
        "fingerprint_scheme",
        "key_id",
        "pillar_fingerprint",
        "exporter",
        "representations",
        "ordering",
        "dependencies",
        "coverage"
      ],
      "properties": {
        "schema_version": {
          "$ref": "./pillar_legend_v0.json#/definitions/SchemaVersion"
        },
        "manifest_scheme": {
          "type": "string",
          "const": "traigent.recovery_manifest.v0"
        },
        "kind": {
          "$ref": "./pillar_legend_v0.json#/definitions/EntityKind"
        },
        "fingerprint_scheme": {
          "$ref": "./pillar_legend_v0.json#/definitions/FingerprintScheme"
        },
        "key_id": {
          "oneOf": [
            {
              "$ref": "./pillar_legend_v0.json#/definitions/KeyId"
            },
            {
              "type": "null"
            }
          ]
        },
        "pillar_fingerprint": {
          "$ref": "./pillar_legend_v0.json#/definitions/Fingerprint"
        },
        "exporter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exporter_id",
            "exporter_version"
          ],
          "properties": {
            "exporter_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}(?![\\s\\S])"
            },
            "exporter_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])",
              "maxLength": 32
            }
          }
        },
        "representations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/definitions/Representation"
          },
          "description": "ORDERED: ordinals are 0..n-1 in array order (consumer check); order is part of the manifest fingerprint."
        },
        "ordering": {
          "$ref": "#/definitions/Ordering"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/Dependency"
          }
        },
        "coverage": {
          "$ref": "./pillar_legend_v0.json#/definitions/Coverage"
        }
      },
      "description": "Client-side recovery manifest. It binds the pillar identity/key, exporter version, ordered representation digests, dependencies and coverage. Stays client-side/in the store; only its fingerprint, coverage and enums cross the bridge.",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "evaluation_dataset"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ordering": {
                "const": "preserved"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/RecoveryManifestV0"
    }
  ]
}
