{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/legend/v0/recovery_manifest_v0.json",
  "title": "Recovery Manifest V0",
  "description": "Recovery manifest whose scheme-qualified fingerprint is the ClientStore key. Closed schema (additionalProperties false everywhere, closed enums, no free text): any new field or enum value ships as a new schema_version published alongside this one; consumers dispatch on schema_version. Normative text: docs/identity/pillar-legend-v0.md. Every string pattern ends with the portable end anchor (?![\\s\\S]) rather than $.",
  "version": "0.1.0",
  "definitions": {
    "RepresentationKind": {
      "type": "string",
      "enum": [
        "source_bundle",
        "prompt_files",
        "helper_modules",
        "tool_definitions",
        "config_document",
        "dependency_lock",
        "dataset_rows",
        "evaluator_bundle",
        "judge_config_document",
        "search_space_document"
      ]
    },
    "Representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "representation_kind",
        "digest",
        "byte_length"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "representation_kind": {
          "$ref": "#/definitions/RepresentationKind"
        },
        "digest": {
          "$ref": "./pillar_legend_v0.json#/definitions/Sha256Digest"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "Dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_ref",
        "kind"
      ],
      "properties": {
        "version_ref": {
          "$ref": "./pillar_legend_v0.json#/definitions/VersionRef"
        },
        "kind": {
          "$ref": "./pillar_legend_v0.json#/definitions/EntityKind"
        }
      },
      "description": "Another declared version this capture needs to be restorable (by opaque ref, never by name)."
    },
    "Rederivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_entity_ref",
        "skipped_file_count"
      ],
      "properties": {
        "source_entity_ref": {
          "oneOf": [
            {
              "$ref": "./pillar_legend_v0.json#/definitions/EntityRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped_file_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "description": "Closed re-derivation inputs: the opaque entity the capture was taken for, and how many files the exporter could not read. skipped_file_count > 0 forces partial coverage."
    },
    "Ordering": {
      "type": "string",
      "enum": [
        "preserved",
        "not_applicable"
      ]
    },
    "RecoveryManifestV0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "manifest_scheme",
        "kind",
        "fingerprint_scheme",
        "key_id",
        "pillar_fingerprint",
        "exporter",
        "representations",
        "ordering",
        "dependencies",
        "coverage",
        "identity_digests_reproduced",
        "rederivation"
      ],
      "properties": {
        "schema_version": {
          "$ref": "./pillar_legend_v0.json#/definitions/SchemaVersion"
        },
        "manifest_scheme": {
          "type": "string",
          "const": "traigent.recovery_manifest.v0"
        },
        "kind": {
          "$ref": "./pillar_legend_v0.json#/definitions/EntityKind"
        },
        "fingerprint_scheme": {
          "$ref": "./pillar_legend_v0.json#/definitions/FingerprintScheme"
        },
        "key_id": {
          "oneOf": [
            {
              "$ref": "./pillar_legend_v0.json#/definitions/KeyId"
            },
            {
              "type": "null"
            }
          ]
        },
        "pillar_fingerprint": {
          "$ref": "./pillar_legend_v0.json#/definitions/Fingerprint"
        },
        "exporter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exporter_id",
            "exporter_version"
          ],
          "properties": {
            "exporter_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}(?![\\s\\S])"
            },
            "exporter_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])",
              "maxLength": 32
            }
          }
        },
        "representations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/definitions/Representation"
          },
          "description": "ORDERED: ordinals are 0..n-1 in array order (consumer check); order is part of the manifest fingerprint."
        },
        "ordering": {
          "$ref": "#/definitions/Ordering"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/Dependency"
          }
        },
        "coverage": {
          "$ref": "./pillar_legend_v0.json#/definitions/Coverage"
        },
        "identity_digests_reproduced": {
          "type": "boolean"
        },
        "rederivation": {
          "$ref": "#/definitions/Rederivation"
        }
      },
      "description": "Client-side recovery manifest. It binds the pillar identity/key, exporter version, ordered representation digests, dependencies and coverage. Stays client-side/in the store; only its fingerprint, coverage and enums cross the bridge.",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "fingerprint_scheme": {
                "type": "string",
                "enum": [
                  "agent_build_digest_v1"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "configuration"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "fingerprint_scheme": {
                "type": "string",
                "enum": [
                  "applied_config_digest_v1"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "evaluation_dataset"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "fingerprint_scheme": {
                "type": "string",
                "enum": [
                  "dataset_multiset_root_v1",
                  "dataset_content_digest_v1"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "evaluator"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "fingerprint_scheme": {
                "type": "string",
                "enum": [
                  "evaluator_version_digest_v1",
                  "judge_config_digest_v1"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "search_space"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "fingerprint_scheme": {
                "type": "string",
                "enum": [
                  "search_space_ssp1"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fingerprint_scheme": {
                "const": "agent_build_digest_v1"
              }
            },
            "required": [
              "fingerprint_scheme"
            ]
          },
          "then": {
            "properties": {
              "key_id": {
                "type": "null"
              },
              "pillar_fingerprint": {
                "$ref": "./pillar_legend_v0.json#/definitions/Sha256Digest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fingerprint_scheme": {
                "const": "applied_config_digest_v1"
              }
            },
            "required": [
              "fingerprint_scheme"
            ]
          },
          "then": {
            "properties": {
              "key_id": {
                "type": "null"
              },
              "pillar_fingerprint": {
                "$ref": "./pillar_legend_v0.json#/definitions/Sha256Digest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fingerprint_scheme": {
                "const": "dataset_content_digest_v1"
              }
            },
            "required": [
              "fingerprint_scheme"
            ]
          },
          "then": {
            "properties": {
              "key_id": {
                "type": "null"
              },
              "pillar_fingerprint": {
                "$ref": "./pillar_legend_v0.json#/definitions/Sha256Digest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fingerprint_scheme": {
                "const": "dataset_multiset_root_v1"
              }
            },
            "required": [
              "fingerprint_scheme"
            ]
          },
          "then": {
            "properties": {
              "key_id": {
                "$ref": "./pillar_legend_v0.json#/definitions/KeyId"
              },
              "pillar_fingerprint": {
                "$ref": "./pillar_legend_v0.json#/definitions/MultisetRoot"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fingerprint_scheme": {
                "const": "evaluator_version_digest_v1"
              }
            },
            "required": [
              "fingerprint_scheme"
            ]
          },
          "then": {
            "properties": {
              "key_id": {
                "type": "null"
              },
              "pillar_fingerprint": {
                "$ref": "./pillar_legend_v0.json#/definitions/Sha256Digest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fingerprint_scheme": {
                "const": "judge_config_digest_v1"
              }
            },
            "required": [
              "fingerprint_scheme"
            ]
          },
          "then": {
            "properties": {
              "key_id": {
                "type": "null"
              },
              "pillar_fingerprint": {
                "$ref": "./pillar_legend_v0.json#/definitions/Sha256Digest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fingerprint_scheme": {
                "const": "search_space_ssp1"
              }
            },
            "required": [
              "fingerprint_scheme"
            ]
          },
          "then": {
            "properties": {
              "key_id": {
                "$ref": "./pillar_legend_v0.json#/definitions/KeyId"
              },
              "pillar_fingerprint": {
                "$ref": "./pillar_legend_v0.json#/definitions/SearchSpaceId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "evaluation_dataset"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ordering": {
                "const": "preserved"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              },
              "coverage": {
                "properties": {
                  "status": {
                    "const": "complete"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "kind",
              "coverage"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "covered": {
                    "allOf": [
                      {
                        "contains": {
                          "const": "code"
                        }
                      },
                      {
                        "contains": {
                          "const": "prompts"
                        }
                      },
                      {
                        "contains": {
                          "const": "helper_modules"
                        }
                      },
                      {
                        "contains": {
                          "const": "tool_definitions"
                        }
                      },
                      {
                        "contains": {
                          "const": "applied_config"
                        }
                      },
                      {
                        "contains": {
                          "const": "runtime"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "configuration"
              },
              "coverage": {
                "properties": {
                  "status": {
                    "const": "complete"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "kind",
              "coverage"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "covered": {
                    "allOf": [
                      {
                        "contains": {
                          "const": "applied_config"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "evaluation_dataset"
              },
              "coverage": {
                "properties": {
                  "status": {
                    "const": "complete"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "kind",
              "coverage"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "covered": {
                    "allOf": [
                      {
                        "contains": {
                          "const": "dataset_members"
                        }
                      },
                      {
                        "contains": {
                          "const": "dataset_order"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "evaluator"
              },
              "coverage": {
                "properties": {
                  "status": {
                    "const": "complete"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "kind",
              "coverage"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "covered": {
                    "allOf": [
                      {
                        "contains": {
                          "const": "evaluator_code"
                        }
                      },
                      {
                        "contains": {
                          "const": "judge_config"
                        }
                      },
                      {
                        "contains": {
                          "const": "objectives"
                        }
                      },
                      {
                        "contains": {
                          "const": "helper_modules"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "search_space"
              },
              "coverage": {
                "properties": {
                  "status": {
                    "const": "complete"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "kind",
              "coverage"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "covered": {
                    "allOf": [
                      {
                        "contains": {
                          "const": "search_space_definition"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              },
              "coverage": {
                "properties": {
                  "status": {
                    "const": "complete"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "kind",
              "coverage"
            ]
          },
          "then": {
            "properties": {
              "identity_digests_reproduced": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "evaluator"
              },
              "coverage": {
                "properties": {
                  "status": {
                    "const": "complete"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "kind",
              "coverage"
            ]
          },
          "then": {
            "properties": {
              "identity_digests_reproduced": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "rederivation": {
                "properties": {
                  "skipped_file_count": {
                    "minimum": 1
                  }
                },
                "required": [
                  "skipped_file_count"
                ]
              }
            },
            "required": [
              "rederivation"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "status": {
                    "const": "partial"
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/RecoveryManifestV0"
    }
  ]
}
