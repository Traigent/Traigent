{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/legend/v0/legend_claim_predicate_v0.json",
  "title": "Legend Claim Predicate V0",
  "description": "Evidence-source-labelled predicates the claims compiler may sign. Closed schema (additionalProperties false everywhere, closed enums, no free text): any new field or enum value ships as a new schema_version published alongside this one; consumers dispatch on schema_version. Normative text: docs/identity/pillar-legend-v0.md. Every string pattern ends with the portable end anchor (?![\\s\\S]) rather than $.",
  "version": "0.1.0",
  "definitions": {
    "PredicateType": {
      "type": "string",
      "enum": [
        "declared",
        "captured",
        "restorable_now",
        "restore_verified_client_reported",
        "bound_to_run",
        "evaluated_client_reported",
        "evaluated_traigent_witnessed"
      ]
    },
    "PredicateSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_ref",
        "kind",
        "fingerprint_scheme",
        "key_id",
        "fingerprint"
      ],
      "properties": {
        "version_ref": {
          "$ref": "./pillar_legend_v0.json#/definitions/VersionRef"
        },
        "kind": {
          "$ref": "./pillar_legend_v0.json#/definitions/EntityKind"
        },
        "fingerprint_scheme": {
          "$ref": "./pillar_legend_v0.json#/definitions/FingerprintScheme"
        },
        "key_id": {
          "oneOf": [
            {
              "$ref": "./pillar_legend_v0.json#/definitions/KeyId"
            },
            {
              "type": "null"
            }
          ]
        },
        "fingerprint": {
          "$ref": "./pillar_legend_v0.json#/definitions/Fingerprint"
        }
      }
    },
    "ClaimPredicateV0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "predicate_type",
        "subject",
        "evidence_source",
        "supporting_event_refs",
        "recovery_manifest_fingerprint",
        "coverage_status",
        "run_tuple_digest",
        "as_of",
        "policy_version"
      ],
      "properties": {
        "schema_version": {
          "$ref": "./pillar_legend_v0.json#/definitions/SchemaVersion"
        },
        "predicate_type": {
          "$ref": "#/definitions/PredicateType"
        },
        "subject": {
          "$ref": "#/definitions/PredicateSubject"
        },
        "evidence_source": {
          "$ref": "./pillar_legend_v0.json#/definitions/EvidenceSource"
        },
        "supporting_event_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "./pillar_legend_v0.json#/definitions/EventRef"
          }
        },
        "recovery_manifest_fingerprint": {
          "oneOf": [
            {
              "$ref": "./pillar_legend_v0.json#/definitions/ManifestFingerprint"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage_status": {
          "oneOf": [
            {
              "$ref": "./pillar_legend_v0.json#/definitions/CoverageStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_tuple_digest": {
          "oneOf": [
            {
              "$ref": "./pillar_legend_v0.json#/definitions/Sha256Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "as_of": {
          "$ref": "./pillar_legend_v0.json#/definitions/Timestamp"
        },
        "policy_version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?![\\s\\S])"
        }
      },
      "description": "One signed-statement predicate. A signature authenticates the statement, not the truth of a client assertion; render the evidence_source beside every predicate. Later evidence is a NEW statement.",
      "allOf": [
        {
          "if": {
            "properties": {
              "predicate_type": {
                "const": "declared"
              }
            },
            "required": [
              "predicate_type"
            ]
          },
          "then": {
            "properties": {
              "evidence_source": {
                "type": "string",
                "enum": [
                  "client_reported"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate_type": {
                "const": "captured"
              }
            },
            "required": [
              "predicate_type"
            ]
          },
          "then": {
            "properties": {
              "evidence_source": {
                "type": "string",
                "enum": [
                  "client_sdk_reported"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate_type": {
                "const": "restorable_now"
              }
            },
            "required": [
              "predicate_type"
            ]
          },
          "then": {
            "properties": {
              "evidence_source": {
                "type": "string",
                "enum": [
                  "client_sdk_reported"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate_type": {
                "const": "restore_verified_client_reported"
              }
            },
            "required": [
              "predicate_type"
            ]
          },
          "then": {
            "properties": {
              "evidence_source": {
                "type": "string",
                "enum": [
                  "client_sdk_reported"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate_type": {
                "const": "bound_to_run"
              }
            },
            "required": [
              "predicate_type"
            ]
          },
          "then": {
            "properties": {
              "evidence_source": {
                "type": "string",
                "enum": [
                  "server_recorded"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate_type": {
                "const": "evaluated_client_reported"
              }
            },
            "required": [
              "predicate_type"
            ]
          },
          "then": {
            "properties": {
              "evidence_source": {
                "type": "string",
                "enum": [
                  "client_reported"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate_type": {
                "const": "evaluated_traigent_witnessed"
              }
            },
            "required": [
              "predicate_type"
            ]
          },
          "then": {
            "properties": {
              "evidence_source": {
                "type": "string",
                "enum": [
                  "traigent_witnessed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate_type": {
                "const": "captured"
              }
            },
            "required": [
              "predicate_type"
            ]
          },
          "then": {
            "properties": {
              "recovery_manifest_fingerprint": {
                "$ref": "./pillar_legend_v0.json#/definitions/ManifestFingerprint"
              },
              "coverage_status": {
                "$ref": "./pillar_legend_v0.json#/definitions/CoverageStatus"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate_type": {
                "const": "restorable_now"
              }
            },
            "required": [
              "predicate_type"
            ]
          },
          "then": {
            "properties": {
              "recovery_manifest_fingerprint": {
                "$ref": "./pillar_legend_v0.json#/definitions/ManifestFingerprint"
              },
              "coverage_status": {
                "$ref": "./pillar_legend_v0.json#/definitions/CoverageStatus"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate_type": {
                "const": "restore_verified_client_reported"
              }
            },
            "required": [
              "predicate_type"
            ]
          },
          "then": {
            "properties": {
              "recovery_manifest_fingerprint": {
                "$ref": "./pillar_legend_v0.json#/definitions/ManifestFingerprint"
              },
              "coverage_status": {
                "$ref": "./pillar_legend_v0.json#/definitions/CoverageStatus"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate_type": {
                "const": "bound_to_run"
              }
            },
            "required": [
              "predicate_type"
            ]
          },
          "then": {
            "properties": {
              "run_tuple_digest": {
                "$ref": "./pillar_legend_v0.json#/definitions/Sha256Digest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate_type": {
                "const": "evaluated_client_reported"
              }
            },
            "required": [
              "predicate_type"
            ]
          },
          "then": {
            "properties": {
              "run_tuple_digest": {
                "$ref": "./pillar_legend_v0.json#/definitions/Sha256Digest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate_type": {
                "const": "evaluated_traigent_witnessed"
              }
            },
            "required": [
              "predicate_type"
            ]
          },
          "then": {
            "properties": {
              "run_tuple_digest": {
                "$ref": "./pillar_legend_v0.json#/definitions/Sha256Digest"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/ClaimPredicateV0"
    }
  ]
}
