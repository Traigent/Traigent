        },
        "event_type": {
          "type": "string",
          "const": "restore_verified"
        },
        "kind": {
          "$ref": "#/definitions/EntityKind"
        },
        "recovery_manifest_fingerprint": {
          "$ref": "#/definitions/ManifestFingerprint"
        },
        "outcome": {
          "$ref": "#/definitions/RestoreOutcome"
        },
        "coverage": {
          "$ref": "#/definitions/Coverage"
        },
        "isolated_destination": {
          "type": "boolean",
          "const": true
        },
        "representation_digests_match": {
          "type": "boolean"
        },
        "pillar_fingerprint_match": {
          "type": "boolean"
        },
        "backend_match_result": {
          "$ref": "#/definitions/MatchResult"
        }
      },
      "description": "Restore into an isolated destination re-hashed. Client origin: client_sdk_reported, no Backend result. Server origin: the Backend's own server-side recompute of the same manifest (backend_match_result match|mismatch), the only way a Backend-keyed pillar (search_space) reaches exact.",
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "exact"
              }
            }
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "status": {
                    "const": "complete"
                  }
                }
              },
              "representation_digests_match": {
                "const": true
              },
              "pillar_fingerprint_match": {
                "const": true
              },
              "backend_match_result": {
                "enum": [
                  "not_applicable",
                  "match"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "client"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_source": {
                "const": "client_sdk_reported"
              },
              "backend_match_result": {
                "enum": [
                  "not_applicable",
                  "not_checked"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "server"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_source": {
                "const": "server_recorded"
              },
              "backend_match_result": {
                "enum": [
                  "match",
                  "mismatch"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "search_space"
              },
              "outcome": {
                "const": "exact"
              }
            },
            "required": [
              "kind",
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "origin": {
                "const": "server"
              },
              "backend_match_result": {
                "const": "match"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend_match_result": {
                "const": "mismatch"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "partial",
                  "substituted",
                  "failed"
                ]
              }
            }
          }
        }
      ]
    },
